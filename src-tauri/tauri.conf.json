{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Lirio",
  "version": "0.2.7",
  "identifier": "app.lirio.launcher",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Lirio",
        "width": 1440,
        "height": 860,
        "minWidth": 1100,
        "minHeight": 700,
        "resizable": true,
        "decorations": false,
        "center": true,
        "backgroundColor": "#0b0816"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "shortDescription": "Lirio: tus bots, a un clic",
    "publisher": "Lirio",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Spanish"
        ],
        "displayLanguageSelector": false,
        "installerHooks": "./nsis-hooks.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDEzRDZDRTYxRkZENTg1NkQKUldSdGhkWC9ZYzdXRTl1eWxHTFlPclZ6V0tQN1RnWFArZW8xU09Bei9VbTQxbHlDek9ydFlXMDgK",
      "endpoints": [],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}